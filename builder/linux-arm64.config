CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_ALLOW_BUILD_AS_ROOT=y
CT_ALLOW_BUILD_AS_ROOT_SURE=y
CT_PREFIX_DIR="/opt/cross/${CT_TARGET}"
CT_LOCAL_TARBALLS_DIR="/tmp/ctng-downloads"
CT_SAVE_TARBALLS=y
CT_LOG_PROGRESS_BAR=n
CT_ARCH_ARM=y
CT_ARCH_64=y
CT_ARCH_ARCH="armv8-a"
CT_TARGET_VENDOR="unknown"
CT_KERNEL_LINUX=y
CT_LINUX_V_4_20=y
CT_LIBC_GLIBC=y
CT_GLIBC_V_2_34=y
CT_GCC_V_14=y
CT_CC_LANG_CXX=y
CT_BINUTILS_PLUGINS=y
CT_DEBUG_GDB=n
